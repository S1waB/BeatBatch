# BeatBatch Backend Configuration
# Copy this file to .env and adjust values as needed.

# Directory where downloaded MP3 files are stored temporarily
DOWNLOAD_DIR=downloads

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Uvicorn host and port
HOST=0.0.0.0
PORT=8000

# ── Cookie settings (fix "This video is unavailable" / IP-block errors) ───
#
# Option A – read cookies automatically from an installed browser.
# BeatBatch will use the browser you are logged into YouTube with.
# Values: auto | chrome | edge | firefox | brave | opera | chromium | vivaldi
# Use "auto" to try chrome → edge → firefox in order (recommended).
# Use "" (empty) to disable browser cookie extraction entirely.
COOKIES_FROM_BROWSER=auto

# Option B – point to a Netscape-format cookies.txt file instead.
# Export from your browser with the "Get cookies.txt LOCALLY" extension.
# Leave empty to use Option A (browser extraction) instead.
COOKIE_FILE=
